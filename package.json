{
  "name": "yahli-space-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Yahli's Space Lab - local learning app (P0)",
  "scripts": {
    "dev": "vite --port 5180 --strictPort --host localhost",
    "dev:lan": "vite --port 5180 --strictPort --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:raw": "vite build",
    "candidate": "node ops/candidate.mjs",
    "candidate:preview": "node ops/preview-candidate.mjs",
    "prod:start": "node ops/prod.mjs start",
    "prod:stop": "node ops/prod.mjs stop",
    "prod:status": "node ops/prod.mjs status",
    "release:list": "node ops/releases.mjs list",
    "release:promote": "node ops/releases.mjs promote",
    "release:rollback": "node ops/releases.mjs rollback",
    "progress:test": "node ops/progress-test.mjs",
    "verify:isolation": "node ops/verify-isolation.mjs",
    "test:browser": "node tests/browser/flow.mjs",
    "gate": "node ops/gate.mjs",
    "phase:next": "node ops/phase.mjs next",
    "phase:status": "node ops/phase.mjs status",
    "backup:obsidian": "node ops/backup-obsidian.mjs",
    "phase:replan": "node ops/phase.mjs replan"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "1.49.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
