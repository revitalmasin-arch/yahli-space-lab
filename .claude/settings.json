{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ops/hooks/phase-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking phase gate"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"[console]::beep(880,180); [console]::beep(1175,260)\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
