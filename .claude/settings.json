{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ops/hooks/phase-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking phase gate"
          }
        ]
      }
    ]
  }
}
